From python:3.12-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Persistent API server (api.py) by default. Run the one-shot CLI pipeline
# instead with: docker run <image> python main.py
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]

